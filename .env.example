LOOPLISH_HOST=127.0.0.1
LOOPLISH_PORT=8756
LOOPLISH_ENV_FILE=.env
LOOPLISH_WEB_ORIGIN=http://127.0.0.1:5173
LOOPLISH_WEB_DIST_DIR=
LOOPLISH_DATA_DIR=
LOOPLISH_MODELS_DIR=
LOOPLISH_LOG_DIR=
LOOPLISH_FFMPEG_PATH=
LOOPLISH_FFPROBE_PATH=
LOOPLISH_MAX_WORKERS=1
LOOPLISH_MAX_UPLOAD_BYTES=2147483648
LOOPLISH_MAX_DOWNLOAD_BYTES=2147483648
LOOPLISH_MAX_MEDIA_SECONDS=14400
LOOPLISH_ASR_BACKEND=local
LOOPLISH_ASR_MODEL=small.en
LOOPLISH_LANGUAGE=en
LOOPLISH_ASR_DEVICE=auto
LOOPLISH_ASR_COMPUTE_TYPE=int8
# auto：Apple 芯片且装了 mlx-whisper 时用 GPU 识别，否则用 faster-whisper；可选 faster-whisper / mlx
LOOPLISH_ASR_ENGINE=auto
# faster-whisper 的 CPU 线程数，留空按核心数自动选择
LOOPLISH_ASR_CPU_THREADS=
LOOPLISH_ASR_API_KEY=
LOOPLISH_ASR_BASE_URL=
LOOPLISH_ASR_API_MODEL=
LOOPLISH_SUBTITLE_SOURCE=auto
LOOPLISH_SUBTITLE_LANGUAGES=en,en-US,en-GB
LOOPLISH_SEG_MIN_SECONDS=1.0
LOOPLISH_SEG_MAX_SECONDS=30.0
LOOPLISH_SEG_HARD_PAUSE_SECONDS=0.75
LOOPLISH_SEG_LEAD_PAD_SECONDS=0.30
LOOPLISH_SEG_TAIL_PAD_SECONDS=0.40
# 允许用服务器本机文件路径创建任务：true/false；留空时只在监听回环地址（127.0.0.1）时允许
LOOPLISH_ALLOW_LOCAL_PATHS=
